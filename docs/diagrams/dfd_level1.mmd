%% MediConnect - Data Flow Diagram (DFD) Level 1
%% System Decomposition

flowchart TB
    classDef entity fill:#FFFFFF,stroke:#000000,stroke-width:2px;
    classDef process fill:#FFFFFF,stroke:#000000,stroke-width:1.5px,rx:15,ry:15;
    classDef store fill:#FAFAFA,stroke:#000000,stroke-width:1.5px;

    ASHA["ASHA Worker"]:::entity

    %% Processes
    P1(["1.0 Manage Health Records"]):::process
    P2(["2.0 Predict Maternal Health Risk"]):::process
    P3(["3.0 Manage Immunization Follow-up"]):::process
    P4(["4.0 Detect Disease Outbreak"]):::process
    P5(["5.0 View Risk & Health Alerts"]):::process
    P6(["6.0 View Immunization Follow-up List"]):::process
    P7(["7.0 Access Offline Records"]):::process
    P8(["8.0 Synchronize Records"]):::process

    %% Data Stores
    D1[("D1 Patients")]:::store
    D2[("D2 Maternal Records")]:::store
    D3[("D3 Children & Immunizations")]:::store
    D4[("D4 Symptom Logs")]:::store
    D5[("D5 Browser Offline Queue")]:::store
    D6[("D6 Sync Audit")]:::store

    %% 1.0 Manage Health Records
    ASHA -->|Patient Info / Child Info| P1
    P1 -->|Store Patient Details| D1
    P1 -->|Store Child Details| D3
    D1 -->|Read Patient Record| P1
    P1 -->|Display Records| ASHA

    %% 2.0 Predict Maternal Health Risk
    ASHA -->|6 Clinical Parameters| P2
    P2 -->|Save Risk Prediction & Visit| D2
    P2 -->|Predicted Risk & Procedural Guidance| ASHA

    %% 3.0 Manage Immunization Follow-up
    D3 -->|Child & Vaccination Dates| P3
    P3 -->|UIP Rule Evaluation| P6
    ASHA -->|Administer Dose Update| P3
    P3 -->|Update Vaccination Status| D3

    %% 4.0 Detect Disease Outbreak
    ASHA -->|Log Symptom Case| P4
    P4 -->|Store Symptom Entry| D4
    D4 -->|Retrieve 7d & 30d Logs| P4
    P4 -->|Anomaly Criteria Evaluation| P5

    %% 5.0 View Alerts
    D2 -->|High-Risk Records| P5
    P5 -->|Display Maternal & Outbreak Alerts| ASHA

    %% 6.0 View Immunization Follow-up List
    P6 -->|Display Due & Overdue Lists| ASHA

    %% 7.0 Access Offline Records
    ASHA -->|Offline Query / Entry| P7
    P7 <-->|Read / Write Pending Records| D5
    P7 -->|Display Cached Data| ASHA

    %% 8.0 Synchronize Records
    ASHA -->|Sync Request / Auto Reconnect| P8
    D5 -->|Read Pending Queue| P8
    P8 -->|Batch Insert Patients| D1
    P8 -->|Batch Insert Visits| D2
    P8 -->|Batch Insert/Update Immunizations| D3
    P8 -->|Batch Insert Symptoms| D4
    P8 -->|Record Sync Receipt| D6
    P8 -->|Sync Summary Status| ASHA
